{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SCOPE/nosana-receipts/blob/main/src/schema/probe-receipt.schema.json",
  "title": "ProbeReceipt",
  "description": "A Receipt extended with conformance probe results (device info, correctness, performance).",
  "allOf": [
    { "$ref": "./receipt.schema.json" },
    {
      "properties": {
        "device_info": {
          "type": "object",
          "description": "GPU device info recorded inside the probe container.",
          "required": ["device_name", "cuda_version", "cuda_driver_version", "nvidia_driver_version", "compute_capability"],
          "additionalProperties": false,
          "properties": {
            "device_name":            { "type": "string", "minLength": 1 },
            "cuda_version":           { "type": "string", "minLength": 1, "description": "CUDA runtime version bundled with the container image, e.g. '12.1'." },
            "cuda_driver_version":    { "type": "string", "minLength": 1, "description": "CUDA driver API version from cuDriverGetVersion — the highest CUDA version the installed NVIDIA driver supports, e.g. '13.2'. Not the NVIDIA display driver version." },
            "nvidia_driver_version":  { "type": "string", "minLength": 1, "description": "NVIDIA display driver version from nvidia-smi, e.g. '545.23.08'. 'unknown' if nvidia-smi was unavailable." },
            "compute_capability":     { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
          }
        },
        "correctness": {
          "type": "object",
          "description": "Tolerance-based correctness check against reference float values from a canonical GPU run.",
          "required": [
            "benchmark_id",
            "reference_sum", "reference_norm", "reference_corners",
            "epsilon_rel",
            "measured_sum", "measured_norm", "measured_corners",
            "max_rel_error", "pass"
          ],
          "additionalProperties": false,
          "properties": {
            "benchmark_id": {
              "type": "string",
              "minLength": 1,
              "description": "Benchmark identifier, e.g. 'gemm-fp32-1024-seed42-torch'."
            },
            "reference_sum":  { "type": ["number", "null"] },
            "reference_norm": { "type": ["number", "null"] },
            "reference_corners": {
              "oneOf": [
                { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
                { "type": "null" }
              ]
            },
            "epsilon_rel": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Max relative error tolerance: |m-r|/|r| ≤ epsilon_rel."
            },
            "measured_sum":  { "type": ["number", "null"] },
            "measured_norm": { "type": ["number", "null"] },
            "measured_corners": {
              "oneOf": [
                { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
                { "type": "null" }
              ]
            },
            "max_rel_error": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "Worst-case relative error across all checked values."
            },
            "pass": {
              "type": ["boolean", "null"],
              "description": "True iff max_rel_error ≤ epsilon_rel."
            }
          }
        },
        "performance": {
          "type": "object",
          "description": "Measured GPU TFLOPS vs gpu_class reference.",
          "required": ["gpu_class", "reference_tflops", "measured_tflops", "conformance_score", "calibrated"],
          "additionalProperties": false,
          "properties": {
            "gpu_class": {
              "type": "string",
              "minLength": 1
            },
            "reference_tflops": {
              "type": ["number", "null"],
              "exclusiveMinimum": 0
            },
            "measured_tflops": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "conformance_score": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1,
              "description": "measured_tflops / reference_tflops, clamped to [0, 1]. Null when calibrated is false."
            },
            "calibrated": {
              "type": "boolean",
              "description": "False until reference_tflops is measured at the same benchmark size and method (warm-up, N≥8192, median of several timed repeats). When false, conformance_score is null and must not be used as a verdict."
            }
          }
        }
      }
    }
  ]
}
